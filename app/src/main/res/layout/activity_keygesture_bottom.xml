<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="590dp"
        android:layout_height="230dp"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"
        android:background="@drawable/frame_round_angle"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:layout_marginLeft="38dp"
            android:layout_marginRight="38dp"
            android:src="@drawable/setting_k_g_gesturesetting_bottom_left">
        </ImageView>

        <LinearLayout
            android:id="@+id/left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="38dp"
            android:layout_marginRight="38dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_left"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="21sp"
                android:layout_gravity="center">
            </TextView>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/setting_k_g_gesturesetting_enter">
            </ImageView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="590dp"
        android:layout_height="230dp"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"
        android:background="@drawable/frame_round_angle"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:layout_marginLeft="38dp"
            android:layout_marginRight="38dp"
            android:src="@drawable/setting_k_g_gesturesetting_bottom_middle">
        </ImageView>

        <LinearLayout
            android:id="@+id/middle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="38dp"
            android:layout_marginRight="38dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_middle"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="21sp"
                android:layout_gravity="center">
            </TextView>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/setting_k_g_gesturesetting_enter">
            </ImageView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="590dp"
        android:layout_height="230dp"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="42dp"
        android:layout_marginRight="42dp"
        android:background="@drawable/frame_round_angle"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:layout_marginLeft="38dp"
            android:layout_marginRight="38dp"
            android:src="@drawable/setting_k_g_gesturesetting_bottom_right">
        </ImageView>

        <LinearLayout
            android:id="@+id/right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="38dp"
            android:layout_marginRight="38dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_right"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="21sp"
                android:layout_gravity="center">
            </TextView>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/setting_k_g_gesturesetting_enter">
            </ImageView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>