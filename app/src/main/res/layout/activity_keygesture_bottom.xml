<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="@dimen/bottom_gesture_card_width"
        android:layout_height="@dimen/bottom_gesture_card_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/bottom_gesture_card_spacing"
        android:background="@drawable/frame_round_angle"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/bottom_gesture_image_width"
            android:layout_height="@dimen/bottom_gesture_image_height"
            android:layout_marginTop="@dimen/bottom_gesture_image_margin_top"
            android:layout_marginLeft="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginRight="@dimen/bottom_gesture_content_horizontal_margin"
            android:src="@drawable/setting_k_g_gesturesetting_bottom_left">
        </ImageView>

        <LinearLayout
            android:id="@+id/left"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_gesture_text_row_height"
            android:layout_marginTop="@dimen/bottom_gesture_image_margin_bottom"
            android:layout_marginLeft="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginRight="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginBottom="@dimen/bottom_gesture_text_margin_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_left"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="21sp"
                android:layout_gravity="center">
            </TextView>

            <ImageView
                android:layout_width="@dimen/bottom_gesture_text_row_height"
                android:layout_height="@dimen/bottom_gesture_text_row_height"
                android:src="@drawable/setting_k_g_gesturesetting_enter">
            </ImageView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/bottom_gesture_card_width"
        android:layout_height="@dimen/bottom_gesture_card_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/bottom_gesture_card_spacing"
        android:background="@drawable/frame_round_angle"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/bottom_gesture_image_width"
            android:layout_height="@dimen/bottom_gesture_image_height"
            android:layout_marginTop="@dimen/bottom_gesture_image_margin_top"
            android:layout_marginLeft="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginRight="@dimen/bottom_gesture_content_horizontal_margin"
            android:src="@drawable/setting_k_g_gesturesetting_bottom_middle">
        </ImageView>

        <LinearLayout
            android:id="@+id/middle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_gesture_text_row_height"
            android:layout_marginTop="@dimen/bottom_gesture_image_margin_bottom"
            android:layout_marginLeft="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginRight="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginBottom="@dimen/bottom_gesture_text_margin_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_middle"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="21sp"
                android:layout_gravity="center">
            </TextView>

            <ImageView
                android:layout_width="@dimen/bottom_gesture_text_row_height"
                android:layout_height="@dimen/bottom_gesture_text_row_height"
                android:src="@drawable/setting_k_g_gesturesetting_enter">
            </ImageView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/bottom_gesture_card_width"
        android:layout_height="@dimen/bottom_gesture_card_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/bottom_gesture_card_spacing"
        android:background="@drawable/frame_round_angle"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/bottom_gesture_image_width"
            android:layout_height="@dimen/bottom_gesture_image_height"
            android:layout_marginTop="@dimen/bottom_gesture_image_margin_top"
            android:layout_marginLeft="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginRight="@dimen/bottom_gesture_content_horizontal_margin"
            android:src="@drawable/setting_k_g_gesturesetting_bottom_right">
        </ImageView>

        <LinearLayout
            android:id="@+id/right"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_gesture_text_row_height"
            android:layout_marginTop="@dimen/bottom_gesture_image_margin_bottom"
            android:layout_marginLeft="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginRight="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginBottom="@dimen/bottom_gesture_text_margin_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_right"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="21sp"
                android:layout_gravity="center">
            </TextView>

            <ImageView
                android:layout_width="@dimen/bottom_gesture_text_row_height"
                android:layout_height="@dimen/bottom_gesture_text_row_height"
                android:src="@drawable/setting_k_g_gesturesetting_enter">
            </ImageView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
