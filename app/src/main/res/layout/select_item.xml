<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/listview_item_height" >

    <TextView
        android:id="@+id/select_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/setting_select_item_margin"
        android:textSize="@dimen/setting_select_item_textSize"/>

    <ImageView
        android:id="@+id/select_icon"
        android:layout_width="@dimen/setting_select_item_iconSize"
        android:layout_height="@dimen/setting_select_item_iconSize"
        android:background="@drawable/check_on"
        android:layout_alignParentRight="true"
        android:layout_marginRight="@dimen/setting_select_item_margin"
        android:layout_centerVertical="true" />
</RelativeLayout>