<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_gravity="center_horizontal">

        <TextView
            android:id="@+id/def_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"/>

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/btn_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/setting_display_prev"
            android:layout_gravity="center">
        </ImageView>

        <androidx.cardview.widget.CardView
            android:layout_width="304dp"
            android:layout_height="405dp"
            android:layout_marginRight="51dp"
            android:layout_marginLeft="51dp"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/def_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/frame_round_angle"/>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/setting_display_next"
            android:layout_gravity="center">
        </ImageView>
    </LinearLayout>

    <com.jzzh.setting.NavigationDotView
        android:id="@+id/dot_navigation"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dot_view_height"
        android:layout_gravity="center_horizontal" />

    <LinearLayout
        android:id="@+id/selection_view"
        android:layout_width="562dp"
        android:layout_height="172dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/frame_round_angle"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp">

            <TextView
                android:id="@+id/checkbox_text"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:textSize="@dimen/textSize20"
                android:layout_gravity="center"/>

            <com.jzzh.tools.ZhCheckBox
                android:id="@+id/checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:layout_gravity="center"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="center"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:background="@color/black">
        </View>

        <LinearLayout
            android:id="@+id/bottom_enter"
            android:layout_width="match_parent"
            android:layout_height="86dp">

            <TextView
                android:id="@+id/bottom_tv"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:textSize="@dimen/textSize20"
                android:layout_gravity="center"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/setting_k_g_gesturesetting_enter"
                android:layout_marginRight="32dp"
                android:layout_gravity="center">
            </ImageView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>