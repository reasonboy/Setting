<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gesture_choose_title_margin_top"
        android:layout_gravity="center_horizontal">

        <TextView
            android:id="@+id/def_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/textSize20"
            android:textStyle="bold"
            android:text="@string/setting_light_gesture"/>

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gesture_choose_preview_margin_top"
        android:layout_gravity="center_horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/gesture_choose_preview_width"
            android:layout_height="@dimen/gesture_choose_preview_height"

            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/def_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/light_gesture_switch_width"
        android:layout_height="@dimen/setting_sub_item_height"
        android:layout_marginTop="@dimen/setting_margin"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/frame_round_angle">

        <TextView
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/setting_light_gesture"
            android:textSize="@dimen/textSize20"
            android:layout_gravity="center"/>

        <com.jzzh.tools.ZhCheckBox
            android:id="@+id/zh_light_gesture_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_gravity="center"/>

    </LinearLayout>

</LinearLayout>
