<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/key_setting"
    android:layout_width="@dimen/volume_key_dialog_width"
    android:layout_height="@dimen/volume_key_dialog_height"
    android:background="@drawable/bg_round">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="20dp"
        android:text="@string/setting_physical_key_setting"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/exit"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="right"
        android:layout_marginTop="22dp"
        android:layout_marginRight="22dp"
        android:background="@drawable/ic_exit" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="71dp"
        android:text="@string/setting_volume_key_title"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/zh_reverse_key_switch"
        android:layout_width="84dp"
        android:layout_height="28dp"
        android:layout_gravity="right"
        android:layout_marginTop="68dp"
        android:layout_marginRight="30dp"
        android:background="@drawable/zh_button_bg_off"
        android:gravity="center"
        android:text="@string/setting_physical_reverse"
        android:textColor="@android:color/white"
        android:textSize="19sp" />

    <ListView
        android:id="@+id/key_setting_listview"
        android:layout_width="match_parent"
        android:layout_height="186dp"
        android:layout_marginLeft="34dp"
        android:layout_marginTop="112dp"
        android:layout_marginRight="34dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="21dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:scrollbars="none" />
</FrameLayout>
