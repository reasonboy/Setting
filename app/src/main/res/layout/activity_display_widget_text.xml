<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_marginTop"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/widget_text_title_margin"
            android:layout_marginRight="@dimen/widget_text_title_margin"
            android:layout_marginBottom="@dimen/widget_text_divider_space"
            android:text="@string/widget_text"
            android:textSize="@dimen/textSize20"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_layout_underline_height"
            android:layout_marginLeft="@dimen/widget_text_title_margin"
            android:layout_marginRight="@dimen/widget_text_title_margin"
            android:background="@color/black" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_text_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_text_divider_space"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/widget_text_setting_margin_left"
            android:textSize="@dimen/textSize20"
            android:text="@string/widget_text_change"/>

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/widget_text_value_margin_left"
            android:layout_marginTop="@dimen/widget_text_value_margin_top"
            android:textSize="@dimen/textSize20"
            android:text="@string/widget_text_default"/>
    </LinearLayout>

</LinearLayout>
