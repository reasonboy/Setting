<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/information_item_height">

    <TextView
        android:id="@+id/information_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/information_item_text_margin"
        android:textSize="@dimen/textSize19"
        tools:text="Title" />

    <TextView
        android:id="@+id/information_item_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/information_item_text_margin"
        android:textSize="@dimen/textSize19"
        tools:text="Information" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_layout_underline_height"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/information_item_divider_margin"
        android:layout_marginRight="@dimen/information_item_divider_margin"
        android:background="@color/black" />
</RelativeLayout>
