<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/setting_margin">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_layout_height"
            android:layout_marginTop="@dimen/activity_marginTop">

            <com.jzzh.setting.TitleLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:title="@string/setting_display_font_size" />

            <TextView
                android:id="@+id/font_size_reset"
                android:layout_width="@dimen/font_size_reset_width"
                android:layout_height="@dimen/font_size_reset_height"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/title_layout_margin"
                android:background="@drawable/zh_button_bg_off"
                android:gravity="center"
                android:text="@string/font_size_reset"
                android:textColor="@color/white"
                android:textSize="@dimen/textSize19" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/title_layout_margin"
            android:layout_marginTop="@dimen/font_size_preview_label_margin_top"
            android:layout_marginEnd="@dimen/title_layout_margin"
            android:text="@string/font_size_preview"
            android:textSize="@dimen/textSize20" />

        <TextView
            android:id="@+id/font_size_preview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/font_size_preview_height"
            android:layout_marginStart="@dimen/title_layout_margin"
            android:layout_marginTop="@dimen/font_size_preview_margin_top"
            android:layout_marginEnd="@dimen/title_layout_margin"
            android:background="@drawable/display_def_apply_frame"
            android:gravity="center"
            android:text="@string/font_size_sample"
            android:textSize="@dimen/textSize20" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/title_layout_margin"
            android:layout_marginTop="@dimen/font_size_adjust_margin_top"
            android:layout_marginEnd="@dimen/title_layout_margin"
            android:text="@string/font_size_adjust"
            android:textSize="@dimen/textSize20" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/font_size_controls_margin_top"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/font_size_decrease"
                android:layout_width="@dimen/light_adjust_button_size"
                android:layout_height="@dimen/light_adjust_button_size"
                android:contentDescription="@string/font_size_decrease"
                android:src="@drawable/soft_bar_on_reduce" />

            <com.jzzh.tools.ZhSeekBar
                android:id="@+id/font_size_seekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/font_size_control_spacing"
                android:layout_marginEnd="@dimen/font_size_control_spacing"
                android:contentDescription="@string/setting_display_font_size"
                app:bg_width="@dimen/font_size_seekbar_width"
                app:bg_height="2dp"
                app:max_value="3"
                app:default_value="1"
                app:tick_size="@dimen/font_size_seekbar_tick_size"
                app:thumb_size="@dimen/font_size_seekbar_thumb_size"
                app:touchable_height="@dimen/font_size_seekbar_touch_height" />

            <ImageView
                android:id="@+id/font_size_increase"
                android:layout_width="@dimen/light_adjust_button_size"
                android:layout_height="@dimen/light_adjust_button_size"
                android:contentDescription="@string/font_size_increase"
                android:src="@drawable/soft_bar_on_increase" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/title_layout_margin"
            android:layout_marginTop="@dimen/font_size_notice_margin_top"
            android:layout_marginEnd="@dimen/title_layout_margin"
            android:text="@string/font_size_notice"
            android:textColor="@color/gray"
            android:textSize="@dimen/textSize19" />
    </LinearLayout>
</ScrollView>
