<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/bottom_gesture_card_width"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/bottom_gesture_card_spacing"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_setting_checkbox_row_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bottom_setting_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/textSize20"
            android:textStyle="bold" />

        <com.jzzh.tools.ZhCheckBox
            android:id="@+id/bottom_setting_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:res_off="@drawable/check_off"
            app:res_on="@drawable/check_on" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_setting_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_gesture_card_height"
        android:layout_marginTop="@dimen/bottom_setting_card_margin_top"
        android:background="@drawable/frame_round_angle"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/bottom_setting_preview"
            android:layout_width="@dimen/bottom_gesture_image_width"
            android:layout_height="@dimen/bottom_gesture_image_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/bottom_gesture_image_margin_top" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_gesture_text_row_height"
            android:layout_marginStart="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginTop="@dimen/bottom_gesture_image_margin_bottom"
            android:layout_marginEnd="@dimen/bottom_gesture_content_horizontal_margin"
            android:layout_marginBottom="@dimen/bottom_gesture_text_margin_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bottom_setting_card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/textSize19" />

            <ImageView
                android:layout_width="@dimen/bottom_gesture_text_row_height"
                android:layout_height="@dimen/bottom_gesture_text_row_height"
                android:src="@drawable/setting_k_g_gesturesetting_enter" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
