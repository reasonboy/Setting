<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_gravity="center_horizontal">

        <TextView
            android:id="@+id/def_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"/>

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/btn_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/setting_display_prev"
            android:layout_gravity="center">
        </ImageView>

        <FrameLayout
            android:layout_width="360dp"
            android:layout_height="480dp"
            android:layout_marginRight="23dp"
            android:layout_marginLeft="23dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/def_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/frame_round_angle"/>
        </FrameLayout>

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/setting_display_next"
            android:layout_gravity="center">
        </ImageView>
    </LinearLayout>

    <com.jzzh.setting.NavigationDotView
        android:id="@+id/dot_navigation"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dot_view_height"
        android:layout_gravity="center_horizontal" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_gravity="center_horizontal">

        <FrameLayout
            android:id="@+id/btn_left"
            android:layout_width="225dp"
            android:layout_height="52dp"
            android:background="@drawable/display_def_apply_frame"
            android:layout_gravity="center_horizontal">

            <TextView
                android:id="@+id/text_btn_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/textSize20"
                android:layout_gravity="center"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_right"
            android:layout_width="225dp"
            android:layout_height="52dp"
            android:layout_marginLeft="20dp"
            android:background="@drawable/display_def_apply_frame"
            android:layout_gravity="center_horizontal">

            <TextView
                android:id="@+id/text_btn_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/textSize20"
                android:layout_gravity="center"/>
        </FrameLayout>

    </LinearLayout>

</LinearLayout>