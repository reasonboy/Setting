<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bt_item_height">

    <LinearLayout
        android:id="@+id/ll_bt_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bt_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/bt_device_item_name_textSize" />

        <TextView
            android:id="@+id/bt_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:visibility="gone"
            android:textSize="@dimen/textSize19"
            android:layout_marginStart="5dp"/>

        <TextView
            android:id="@+id/bt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_active"
            android:textColor="@color/black"
            android:textSize="@dimen/textSize17"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bt_setting"
        android:layout_width="@dimen/bt_setting_icon_size"
        android:layout_height="@dimen/bt_setting_icon_size"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:src="@drawable/setting_bt_setting"
        android:visibility="gone" />
</RelativeLayout>
